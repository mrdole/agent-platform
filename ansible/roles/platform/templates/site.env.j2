# Managed by Ansible (agent-platform). Put keys and tokens in secrets.env, not here.
AP_HOME={{ ap_home }}
AP_VENV={{ ap_venv }}
AP_LLM_BASE_URL={{ ap_llm_base_url }}
AP_KNOWLEDGE_ROOT={{ ap_knowledge_root }}
{% if ap_install_scope == 'user' and ap_personal_knowledge_root is defined %}
AP_KNOWLEDGE_PERSONAL={{ ap_personal_knowledge_root }}
{% endif %}
GITLAB_HOST={{ ap_gitlab_host }}
NODE_EXTRA_CA_CERTS=/etc/pki/tls/certs/ca-bundle.crt
REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
{% if ap_install_scope == 'system' %}
AP_LOCK_DIR=/run/lock/agent-platform
{% endif %}
{% if ap_https_proxy %}
HTTPS_PROXY={{ ap_https_proxy }}
HTTP_PROXY={{ ap_https_proxy }}
NO_PROXY={{ ap_no_proxy }}
{% endif %}
