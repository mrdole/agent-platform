# Role -> model mapping. Change models here, never in profiles.
# Values are provider/model IDs from core/opencode.core.json.
AP_MODEL_PLANNER=corp/laguna-5.2.1
AP_MODEL_BUILDER=corp/gpt-oss-120b
AP_MODEL_SMALL=corp/gpt-oss-20b
AP_MODEL_REVIEWER=corp/gemma-4-31b
AP_MODEL_SCOUT=corp/gemma-4-26b

# Overridden by site.env (written by Ansible) or the caller's environment.
AP_LLM_BASE_URL=https://llm.example.internal/v1

OPENCODE_DISABLE_AUTOUPDATE=1
OPENCODE_DISABLE_SHARE=1
